{
  "name": "nuclear-isotope-id-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Auditable research-oriented gamma-ray isotope identification",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scientific": "vitest run src/physics",
    "test:ui": "vitest run src/test",
    "test:e2e": "playwright test",
    "validate:data": "node scripts/validate-data.mjs",
    "import:data": "python3 scripts/import_iaea.py",
    "check": "npm run validate:data && npm test && npm run typecheck && npm run build",
    "build:standalone": "node scripts/build-standalone.mjs",
    "verify:delivery": "node scripts/run-verification.mjs",
    "audit:calculations": "node scripts/generate-validation.mjs"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
